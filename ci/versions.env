# Every pinned tool version, read by CI and (from #7) by the Docker image.
# Bumping a pin is its own PR: see AGENTS.md, Build and toolchain.
PYTHON_VERSION=3.12
RUFF_VERSION=0.17.1
PYTEST_VERSION=9.1.1
ACTIONLINT_PY_VERSION=1.7.12.25
GIT_CLIFF_VERSION=2.14.2
PYYAML_VERSION=6.0.3
JSONSCHEMA_VERSION=4.26.0
HYPOTHESIS_VERSION=6.170.12
ROS_IMAGE=ros:jazzy-ros-base-noble
# The bridge job's images, one ROS_<distro>_IMAGE per distro it runs. Pinned by
# digest as well as tag: the job is a required check, so a tag alone would let
# an upstream rebuild change its toolchain with no commit here.
ROS_JAZZY_IMAGE=ros:jazzy-ros-base-noble@sha256:103b6c417973394659af6804d4917cd489b91e5ed22eb7bef263025a3bed2410
ROS_LYRICAL_IMAGE=ros:lyrical-ros-base-resolute@sha256:d9078270abaeae65497036085f1654c75ec0a95e2aca5ecf7ddc0846a6cd69e1
# Rolling moves under its tag, so this digest freezes it: refresh the digest
# and gen/r2s_gen/snapshots/rolling/ together when upstream moves. Digest read
# 2026-11-04; resolute supersedes noble, whose tag is stale since 2026-07.
ROS_ROLLING_IMAGE=ros:rolling-ros-base-resolute@sha256:fd1a2cf7995148ad54d29fbf452b9084b9b8a386ee36ee8241495410903a58cf
# Checked at image build time: the apt package is not pinned, so drift fails loudly.
AVR_GCC_VERSION=7.3.0
ARDUINO_CLI_VERSION=1.5.1
ARDUINO_AVR_CORE_VERSION=1.8.6
# The ESP32 core installs per check into a cache directory, never into the
# dev image; the ESP32 build script reads this pin.
ARDUINO_ESP32_CORE_VERSION=3.3.12
# The epic-cc bundle the PIC canary compiles with, per check into a cache
# directory, never into the image; the canary script verifies the zip
# against the hash before it runs anything from it.
EPIC_CC_VERSION=0.6.0
EPIC_CC_SHA256=5e598e418a0ac3fb9192fcf1a5ebb9fe0eb26c0ee0751280571e00be6beeb11b
PYSERIAL_VERSION=3.5
GCOVR_VERSION=8.7
COVERAGE_VERSION=7.17.2
# The suite runner: one task per ci-test.sh section, skipped by checksum
# while its inputs match the last successful run. The hash pins the linux
# amd64 tarball, the only architecture the image supports, as arduino-cli.
TASK_VERSION=3.54.0
TASK_SHA256=680859dbb4d881a9c72d4d9a8f510825450849af8567deacd7302c01124416fb
# The mermaid check's image: the official node:22-slim at a pinned digest.
# The dev image gains no Node; make lint-docs runs the check through it.
NODE_IMAGE=node:22-slim@sha256:4b150b48b4116e2a22f2c39cc27025fbf4f153e2078fd3b14d159fdb5c7279da
# The advisory docs build installs this from PyPI on each CI run, never into
# the dev image: rosdoc2 ships no Debian, so the pin lives here, not in apt.
ROSDOC2_VERSION=0.2.1
