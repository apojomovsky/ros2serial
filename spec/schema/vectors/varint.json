{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LEB128 varints",
  "type": "object",
  "properties": {
    "covers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[A-Z]{2,4}-[0-9]+$"
      }
    },
    "cases": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "value": {
                "type": "integer",
                "minimum": 0
              },
              "encoded": {
                "type": "string",
                "pattern": "^$|^[0-9a-f]{2}( [0-9a-f]{2})*$"
              }
            },
            "required": [
              "value",
              "encoded"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "encoded": {
                "type": "string",
                "pattern": "^$|^[0-9a-f]{2}( [0-9a-f]{2})*$"
              },
              "reject": {
                "type": "string",
                "pattern": "^[A-Z]{2,4}-[0-9]+$",
                "description": "the spec ID of the rule that rejects the encoding"
              }
            },
            "required": [
              "encoded",
              "reject"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "covers",
    "cases"
  ],
  "additionalProperties": false
}
