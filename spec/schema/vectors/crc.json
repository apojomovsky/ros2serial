{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CRC-16/MCRF4XX check values",
  "type": "object",
  "properties": {
    "covers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[A-Z]{2,4}-[0-9]+$"
      }
    },
    "cases": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "text": {
                "type": "string"
              },
              "crc": {
                "type": "integer",
                "minimum": 0,
                "maximum": 65535
              }
            },
            "required": [
              "text",
              "crc"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "data": {
                "type": "string",
                "pattern": "^$|^[0-9a-f]{2}( [0-9a-f]{2})*$"
              },
              "crc": {
                "type": "integer",
                "minimum": 0,
                "maximum": 65535
              }
            },
            "required": [
              "data",
              "crc"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "covers",
    "cases"
  ],
  "additionalProperties": false
}
