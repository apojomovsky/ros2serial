{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "r2s_now() results for a tick and a correction",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "covers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[A-Z]{2,4}-[0-9]+$"
      }
    },
    "tick_hz": {
      "type": "integer",
      "minimum": 1000
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "tick0": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "sec0": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "nanosec0": {
            "type": "integer",
            "minimum": 0,
            "maximum": 999999999
          },
          "drift_ppm": {
            "type": "integer",
            "minimum": -20000,
            "maximum": 20000
          },
          "tick": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "expect": {
            "oneOf": [
              {
                "const": "unsynced"
              },
              {
                "type": "object",
                "properties": {
                  "sec": {
                    "type": "integer",
                    "minimum": -2147483648,
                    "maximum": 2147483647
                  },
                  "nanosec": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 999999999
                  }
                },
                "required": [
                  "sec",
                  "nanosec"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "tick0",
          "sec0",
          "nanosec0",
          "drift_ppm",
          "tick",
          "expect"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "name",
    "covers",
    "tick_hz",
    "cases"
  ],
  "additionalProperties": false
}
