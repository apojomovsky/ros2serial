<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>r2s_bridge</name>
  <version>0.0.0</version>
  <description>ROS 2 bridge between a serial port and the rest of the ROS 2 graph.</description>
  <maintainer email="apojomovsky@gmail.com">Alexis Pojomovsky</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>class_loader</test_depend>
  <test_depend>yaml-cpp</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
