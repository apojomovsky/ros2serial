#!/usr/bin/env bash
# pre-commit: whitespace and formatting on the staged files. Warnings are
# checked by the suite and the ritual (make check-warnings), not per commit.
set -uo pipefail
root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
status=0
git diff --cached --check || { echo "pre-commit: whitespace errors in the staged changes"; status=1; }
mapfile -t py < <(git diff --cached --name-only --diff-filter=ACM -- '*.py')
if [ "${#py[@]}" -gt 0 ]; then
  if python3 -m ruff --version >/dev/null 2>&1; then
    python3 -m ruff format --check -- "${py[@]}" || status=1
  elif command -v docker >/dev/null 2>&1; then
    make -s -C "$root" exec CMD="ruff format --check -- ${py[*]}" || status=1
  else
    echo "pre-commit: no ruff and no docker; formatting is left to CI"
  fi
fi
mapfile -t c < <(git diff --cached --name-only --diff-filter=ACM -- '*.c' '*.h' '*.cpp' '*.hpp' '*.cc')
if [ "${#c[@]}" -gt 0 ]; then
  if command -v clang-format >/dev/null 2>&1; then
    bash "$root/scripts/c-format.sh" "${c[@]}" || status=1
  elif command -v docker >/dev/null 2>&1; then
    make -s -C "$root" exec CMD="bash scripts/c-format.sh ${c[*]}" || status=1
  else
    echo "pre-commit: no clang-format and no docker; formatting is left to CI"
  fi
fi
exit $status
