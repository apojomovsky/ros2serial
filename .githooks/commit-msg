#!/usr/bin/env bash
# commit-msg: Conventional Commits, at most 3 lines, no trailers, no em-dashes.
# Every commit is checked, including one made while a merge is in progress:
# the PR is squashed, so no merge commit of its own lands on master.
root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
exec python3 "$root/scripts/commit_check.py" --file "$1"
