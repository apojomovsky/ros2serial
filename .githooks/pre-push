#!/usr/bin/env bash
# pre-push: refuse force pushes, run the prose gate, then the stale fast
# gates only (R2S_LOCAL=1); CI runs the rest on every pull request. A green
# push means the fast gates passed, never that the PR is green.
# A force push is any push whose remote ref is not an ancestor of what is
# pushed: it drops commits other agents may have pulled, so it needs the
# maintainer's go-ahead and R2S_FORCE_PUSH_APPROVED=1.
set -uo pipefail
root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
zero=0000000000000000000000000000000000000000
while read -r local_ref local_oid remote_ref remote_oid; do
  [ -z "${local_ref:-}" ] && continue
  [ "$remote_oid" = "$zero" ] || [ "$local_oid" = "$zero" ] && continue
  if ! git merge-base --is-ancestor "$remote_oid" "$local_oid" 2>/dev/null; then
    if [ "${R2S_FORCE_PUSH_APPROVED:-}" != 1 ]; then
      echo "pre-push: refusing a force push to $remote_ref (needs the maintainer's go-ahead and R2S_FORCE_PUSH_APPROVED=1)"
      exit 1
    fi
  fi
done

base=${BASE:-origin/master}
if git rev-parse --verify -q "$base" >/dev/null; then
  python3 "$root/scripts/prose_check.py" --verify --base "$base" || exit 1
fi

# The checksums decide what runs: tasks whose inputs match their last
# successful run are a fast no-op, so pushing the same tree twice costs
# nothing and no stamp file is needed. R2S_FULL=1 forces all the tasks.
# The suite itself must not see the hook's git variables.
# shellcheck source=scripts/clean-git-env.sh
source "$root/scripts/clean-git-env.sh"
if [ -n "${R2S_PRE_PUSH_SUITE:-}" ]; then
  bash -c "$R2S_PRE_PUSH_SUITE" || exit 1
else R2S_LOCAL=1 make -s -C "$root" image test || exit 1; fi
