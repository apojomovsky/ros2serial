#!/usr/bin/env bash
# pre-push: refuse a force push that drops work, run the prose gate, then the
# exact CI suite.
# A force push is any push whose remote ref is not an ancestor of what is
# pushed, and it needs the maintainer's go-ahead and R2S_FORCE_PUSH_APPROVED=1.
# A rebase of the branch's own commits is allowed: it rewrites the history
# but keeps the changes, and every merge advances master, so without it every
# open branch would need a force push of its own. A rebase is recognised by
# the patch ids, which identify a change whatever its commit sits on.
set -uo pipefail
root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
zero=0000000000000000000000000000000000000000

# The patch ids of the commits in a range, one per line.
patch_ids() {
  git rev-list "$1" 2>/dev/null | while read -r sha; do
    git show --pretty=format: "$sha" 2>/dev/null | git patch-id --stable 2>/dev/null | cut -d' ' -f1
  done | sort -u
}

# Is every change the old ref carries still in the new one? The two sides
# are measured from their common ancestor, which is where they part.
same_changes() {
  local old=$1 new=$2 base dropped added
  base=$(git merge-base "$old" "$new" 2>/dev/null) || return 1
  dropped=$(patch_ids "$old" "^$base")
  [ -z "$dropped" ] && return 0
  added=$(patch_ids "$new" "^$base")
  while read -r id; do
    [ -z "$id" ] && continue
    grep -qx "$id" <<<"$added" || return 1
  done <<<"$dropped"
  return 0
}

while read -r local_ref local_oid remote_ref remote_oid; do
  [ -z "${local_ref:-}" ] && continue
  [ "$remote_oid" = "$zero" ] || [ "$local_oid" = "$zero" ] && continue
  if ! git merge-base --is-ancestor "$remote_oid" "$local_oid" 2>/dev/null; then
    if [ "${R2S_FORCE_PUSH_APPROVED:-}" != 1 ] && ! same_changes "$remote_oid" "$local_oid"; then
      echo "pre-push: refusing a force push to $remote_ref (needs the maintainer's go-ahead and R2S_FORCE_PUSH_APPROVED=1)"
      exit 1
    fi
  fi
done

if git rev-parse --verify -q origin/master >/dev/null; then
  python3 "$root/scripts/prose_check.py" --verify --base origin/master || exit 1
fi

# The stamp records the tree and the suite definition that already passed, so
# pushing the same tree twice does not run the suite twice.
stamp="$(git rev-parse --absolute-git-dir)/r2s-pre-push-stamp"
key="$(git rev-parse 'HEAD^{tree}') $(cat "$root"/.githooks/* "$root/scripts/ci-test.sh" "$root/Makefile" | sha256sum | cut -c1-16)"
if [ -f "$stamp" ] && [ "$(cat "$stamp")" = "$key" ]; then
  echo "pre-push: suite already passed on this tree"
  exit 0
fi
# The stamp path is resolved above; the suite itself must not see the hook's git variables.
# shellcheck source=scripts/clean-git-env.sh
source "$root/scripts/clean-git-env.sh"
bash -c "${R2S_PRE_PUSH_SUITE:-make -s -C "$root" ci-local}" || exit 1
echo "$key" > "$stamp"
